"use client";

import { useState } from "react";

const communities = [
  "Africa Creators",
  "Europe Creators",
  "Asia Creators",
  "International Creators",
  "Scholarships",
  "University Students",
  "Job Opportunities",
  "Football Fans",
  "Young Entrepreneurs",
  "Music Lovers",
  "Gamers",
  "Photography",
  "AI & Technology",
];

export default function Home() {
  const [search, setSearch] = useState("");
  const [post, setPost] = useState("");
  const [posts, setPosts] = useState<string[]>([]);
  const [joined, setJoined] = useState<string[]>([]);

  const filteredCommunities = communities.filter((community) =>
    community.toLowerCase().includes(search.toLowerCase())
  );

  function createPost() {
    if (!post.trim()) return;
    setPosts((previous) => [post.trim(), ...previous]);
    setPost("");
  }

  function toggleJoin(community: string) {
    setJoined((previous) =>
      previous.includes(community)
        ? previous.filter((item) => item !== community)
        : [...previous, community]
    );
  }

  return (
    <main style={{
      maxWidth: 900,
      margin: "0 auto",
      padding: 20,
      fontFamily: "Arial, sans-serif",
      color: "#172033"
    }}>
      <header style={{
        display: "flex",
        justifyContent: "space-between",
        alignItems: "center",
        flexWrap: "wrap",
        gap: 12
      }}>
        <h1 style={{ color: "#5145CD" }}>A-CHKO</h1>
        <span>Watch. Connect. Discover.</span>
      </header>

      <section style={{
        background: "#F1F0FF",
        padding: 24,
        borderRadius: 16,
        marginTop: 20
      }}>
        <h2>Welcome to A-CHKO</h2>
        <p>One hub. Endless possibilities.</p>
        <p>
          Discover opportunities, connect with creators, join communities
          and share your ideas.
        </p>
      </section>

      <section style={{ marginTop: 28 }}>
        <h2>Create a post</h2>
        <textarea
          value={post}
          onChange={(event) => setPost(event.target.value)}
          placeholder="Share your idea or opportunity..."
          rows={4}
          style={{
            width: "100%",
            boxSizing: "border-box",
            padding: 12,
            borderRadius: 10,
            border: "1px solid #CCC"
          }}
        />
        <button onClick={createPost} style={buttonStyle}>
          Create post
        </button>
      </section>

      <section style={{ marginTop: 28 }}>
        <h2>Discover communities</h2>
        <input
          value={search}
          onChange={(event) => setSearch(event.target.value)}
          placeholder="Search groups, jobs, scholarships..."
          style={{
            width: "100%",
            boxSizing: "border-box",
            padding: 12,
            borderRadius: 10,
            border: "1px solid #CCC"
          }}
        />

        <div style={{
          display: "grid",
          gridTemplateColumns: "repeat(auto-fit, minmax(210px, 1fr))",
          gap: 12,
          marginTop: 16
        }}>
          {filteredCommunities.map((community) => (
            <article key={community} style={cardStyle}>
              <h3>{community}</h3>
              <button
                onClick={() => toggleJoin(community)}
                style={buttonStyle}
              >
                {joined.includes(community) ? "Leave group" : "Join group"}
              </button>
            </article>
          ))}
        </div>
      </section>

      <section style={{ marginTop: 28 }}>
        <h2>Community feed</h2>
        {posts.length === 0 ? (
          <p>Your posts will appear here when you create them.</p>
        ) : (
          posts.map((item, index) => (
            <article key={`${index}-${item}`} style={cardStyle}>
              <p>{item}</p>
              <button
                onClick={() =>
                  setPosts((previous) =>
                    previous.filter((_, postIndex) => postIndex !== index)
                  )
                }
                style={buttonStyle}
              >
                Delete post
              </button>
            </article>
          ))
        )}
      </section>

      <footer style={{
        marginTop: 40,
        padding: 20,
        textAlign: "center",
        borderTop: "1px solid #DDD"
      }}>
        <p>A-CHKO — Watch, connect and discover opportunities.</p>
      </footer>
    </main>
  );
}

const buttonStyle = {
  background: "#5145CD",
  color: "#FFFFFF",
  border: "none",
  borderRadius: 8,
  padding: "10px 16px",
  marginTop: 10,
  cursor: "pointer"
} as const;

const cardStyle = {
  border: "1px solid #E0E0E0",
  borderRadius: 12,
  padding: 16,
  marginTop: 10
} as const;
