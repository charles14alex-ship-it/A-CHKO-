# ==========================================
# A-CHKO - Git Ignore Configuration
# Next.js + React + TypeScript + pnpm
# Vercel + Supabase
# ==========================================

# Dependencies
/node_modules
/.pnp
.pnp.*
/.pnpm-store

# Package manager logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js build output
/.next/
/out/
/build/
/dist/

# Production build output
/.vercel/output/

# Vercel local configuration
.vercel

# TypeScript build information
*.tsbuildinfo
next-env.d.ts

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.template

# Local configuration
*.local
*.log

# Supabase local development
supabase/.temp/
supabase/.branches/
supabase/.env

# Testing and coverage
/coverage/
/.nyc_output/
/playwright-report/
/test-results/
/jest-cache/

# IDE and editor files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# Operating system files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Debug files
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local database files
*.sqlite
*.sqlite3
*.db

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.crt

# Service account credentials
service-account*.json
credentials*.json
firebase-adminsdk*.json

# Generated files
*.bak
*.orig
*.rej

# Local uploads and user-generated files
/uploads/
/storage-local/

# Local caches
.cache/
.par
